@model List<TheGala.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>
<p>Records are stored in the <strong>Products</strong> table in Azure Table Storage.</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Product</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Row Key</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>@product.Stock</td>
                    <td><small class="text-muted">@product.RowKey</small></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No products yet.</td>
            </tr>
        }
    </tbody>
</table>
