@model List<TheGala.Models.ProductImage>
@{
    ViewData["Title"] = "Product Images";
}

<h1>Product Images</h1>
<p>Images are stored in the <strong>product-images</strong> container in Azure Blob Storage.</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<p>
    <a asp-action="Upload" class="btn btn-primary">Upload New Image</a>
</p>

@if (Model != null && Model.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var image in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <img src="@image.Url" class="card-img-top" alt="@image.Name" style="object-fit: cover; height: 180px;" />
                    <div class="card-body">
                        <small class="text-muted text-break">@image.Name</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No images uploaded yet.</p>
}
