@{
    ViewData["Title"] = "Upload Product Image";
}

<h1>Upload Product Image</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="col-md-6">
    <div class="mb-3">
        <label for="file" class="form-label">Choose an image</label>
        <input type="file" id="file" name="file" class="form-control" accept="image/*" required />
    </div>

    <button type="submit" class="btn btn-primary">Upload</button>
    <a asp-action="Index" class="btn btn-secondary">Back to gallery</a>
</form>
