@{
    ViewData["Title"] = "Place Order";
}

<h1>Place Order</h1>
<p>Placing an order sends a message to the <strong>orders-queue</strong> queue in Azure Queue Storage.</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" method="post" class="col-md-6">
    <div class="mb-3">
        <label for="productName" class="form-label">Product Name</label>
        <input type="text" id="productName" name="productName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label for="quantity" class="form-label">Quantity</label>
        <input type="number" id="quantity" name="quantity" class="form-control" min="1" value="1" required />
    </div>

    <button type="submit" class="btn btn-primary">Place Order</button>
    <a asp-controller="Queue" asp-action="Index" class="btn btn-secondary">View Queue</a>
</form>
