@model List<TheGala.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}

<h1>Customers</h1>
<p>Records are stored in the <strong>Customers</strong> table in Azure Table Storage.</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Customer</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Row Key</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var customer in Model)
            {
                <tr>
                    <td>@customer.Name</td>
                    <td>@customer.Email</td>
                    <td>@customer.Phone</td>
                    <td><small class="text-muted">@customer.RowKey</small></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No customers yet.</td>
            </tr>
        }
    </tbody>
</table>
