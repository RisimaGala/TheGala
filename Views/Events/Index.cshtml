@model TheGala.Models.EventsOverview
@{
    ViewData["Title"] = "Event Processing";
}

<h1>Event Processing</h1>
<p>Real-time order events on Azure Service Bus - a reliable queue for single-consumer processing, and a topic fanning the same event out to every subscriber.</p>
<p class="text-muted"><small>These panels peek at messages without removing them, so it's safe to refresh. A function usually drains these within seconds of an order being placed.</small></p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<p>
    <a asp-controller="Order" asp-action="Create" class="btn btn-primary">Place an Order</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Refresh</a>
</p>

@{
    async System.Threading.Tasks.Task RenderPanel(string title, string description, List<TheGala.Models.QueueMessageView> messages)
    {
        <h4>@title</h4>
        <p class="text-muted"><small>@description</small></p>
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Message</th>
                    <th>Enqueued On</th>
                </tr>
            </thead>
            <tbody>
                @if (messages != null && messages.Count > 0)
                {
                    foreach (var message in messages)
                    {
                        <tr>
                            <td>@message.Text</td>
                            <td>@message.InsertedOn</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-center">No messages currently waiting (likely already processed).</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@{ await RenderPanel("Order Queue (order-processing)", "Reliable, single-consumer queue processed by the OrderQueueProcessor function.", Model.QueueMessages); }
@{ await RenderPanel("Inventory Updates (order-events → inventory-updates)", "Topic subscription processed by the InventoryUpdate function.", Model.InventoryMessages); }
@{ await RenderPanel("Customer Notifications (order-events → customer-notifications)", "Topic subscription processed by the CustomerNotification function.", Model.NotificationMessages); }
